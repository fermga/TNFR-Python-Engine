# Rebuild the source list from maintained distribution inputs. A positive list
# avoids carrying retired development paths or stale egg-info file inventories.
# Setuptools adds its generated distribution metadata after this template.
global-exclude *
include MANIFEST.in pyproject.toml README.md LICENSE.md CITATION.cff CHANGELOG.md
recursive-include src/tnfr *.py *.pyi *.typed *.json
include scripts/tnfr_is_prime.py
