# Optional environment inputs; this file is not loaded by the engine.
# Export values through your shell/application, or explicitly use an external
# environment-file loader. Keep actual credentials out of version control.

# Backend factory default when no explicit backend is supplied.
# Optional backends need their corresponding installed dependency extra.
TNFR_BACKEND=numpy

# Optional signed persistence helpers read this hexadecimal secret.
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
# TNFR_CACHE_SECRET=

# Optional tnfr.config.security.load_redis_config() inputs. The caller must
# explicitly use the returned configuration; setting these does not enable Redis.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_USE_TLS=false

# Specify study seeds through StudySpec/CLI or the relevant graph configuration.
# TNFR_RANDOM_SEED, TNFR_CACHE_ENABLED and TNFR_LOG_LEVEL are not automatic
# engine controls. Logging uses Python logging configuration.
# Release publishing uses the GitHub workflow's trusted publisher; it does not
# read this file. See .github/WORKFLOWS.md and SECURITY.md for their actual scopes.
